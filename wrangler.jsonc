{
  "name": "mangrove-mews",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mangrove-mews-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
